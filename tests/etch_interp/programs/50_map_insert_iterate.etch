component MapAcc {
  count: int = 0
  key_sum: int = 0
  val_sum: int = 0
}

rule map_ops(entity: Entity)
  when entity has MapAcc
{
  let acc = entity.get_mut(MapAcc)
  let mut m = [1: 10, 2: 20]
  m.insert(3, 30)
  m.insert(2, 25)
  let mut ks = 0
  let mut vs = 0
  for k, v in m {
    ks += k
    vs += v
  }
  acc.count = m.len()
  acc.key_sum = ks
  acc.val_sum = vs
}
