component SetAcc {
  count: int = 0
  empty_len: int = 0
  hit: int = 0
  miss: int = 0
}

rule set_ops(entity: Entity)
  when entity has SetAcc
{
  let acc = entity.get_mut(SetAcc)
  let e: Set<int> = Set.new()
  let mut s = Set.from([1, 2, 2, 3])
  s.insert(4)
  s.insert(2)
  if s.contains(2) {
    acc.hit = 1
  }
  if s.contains(9) {
    acc.miss = 1
  }
  acc.count = s.len()
  acc.empty_len = e.len()
}
