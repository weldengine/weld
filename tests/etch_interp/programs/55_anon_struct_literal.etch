component AnonAcc {
  flat: int = 0
  nested: int = 0
}

struct Pt {
  x: int
  y: int
}

struct Box {
  p: Pt
  k: int
}

rule anon_struct_literals(entity: Entity)
  when entity has AnonAcc
{
  let acc = entity.get_mut(AnonAcc)
  let q: Pt = .{ x: 40, y: 2 }
  let b = Box { p: .{ x: 7, y: 5 }, k: 30 }
  acc.flat = q.x + q.y
  acc.nested = b.p.x + b.p.y + b.k
}
