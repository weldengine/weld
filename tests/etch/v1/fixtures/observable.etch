// M1.0.0 observable — several mixed-filter rules in one program. The harness
// runs one tick over a seeded world and logs each rule's matched-entity count,
// which must equal the hand-computed expectation:
//   r_has   (has Core)                 -> e1, e2, e5         = 3
//   r_not   (Core and not Flag)        -> e1, e5             = 2
//   r_field (Lvl { v > 10 })           -> e4, e5             = 2
component Core { hit: int = 0 }
component Flag { x: int = 0 }
component Lvl {
  v: int = 0
  hit: int = 0
}

rule r_has(entity: Entity)
  when entity has Core
{
  entity.get_mut(Core).hit += 1
}

rule r_not(entity: Entity)
  when entity has Core and not entity has Flag
{
  entity.get_mut(Core).hit += 1
}

rule r_field(entity: Entity)
  when entity has Lvl { v > 10 }
{
  entity.get_mut(Lvl).hit += 1
}
