// E0001 ParseError — `quest` is out of scope until its E4 slice lands; the
// lexer flags it as `error_unknown_keyword`, which the parser raises with
// an "UnsupportedConstructInS3" message. (Replaces the former `behavior`
// fixture: `behavior` graduated to a real keyword with the M0.8 E4 Level-B
// gameplay slice, so it no longer emits E0001.)

quest EscortMerchant {
    stage talk {
        objective main: interact_with("merchant")
    }
}

component Filler {
    v: int = 0
}
