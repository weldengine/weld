// E0001 ParseError — `behavior` (behavior-tree construct) is out of scope
// until E4; the lexer flags it as `error_unknown_keyword`, which the parser
// raises with an "UnsupportedConstructInS3" message. (Replaces the former
// `fn` fixture: `fn` graduated to a real keyword with the M0.8 E2 call
// mechanism, so it no longer emits E0001.)

behavior CombatAI {
    selector {
        action: attack()
    }
}

component Filler {
    v: int = 0
}
