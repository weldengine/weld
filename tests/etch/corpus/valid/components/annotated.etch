// Components decorated with the S3-recognised annotations, each on a
// target it is actually valid for. M0.8 enforces annotation applicability
// (D-S3-annot-applicability, cf. `etch-resolver-types.md` §13.2), so
// `@requires`/`@storage`/`@save` sit on the component itself while
// `@hidden`/`@range`/`@readonly`/`@replicated` sit on fields.

@requires(Transform)
component Light {
    @hidden
    enabled: bool = true

    @range(0, 100000)
    intensity: float = 1000.0

    @readonly
    cached_world_index: i32 = 0
}

@save
component Achievement {
    unlocked: bool = false
    unlock_tick: u32 = 0
}

component Predicted {
    @replicated(predicted)
    flag: bool = false
}

@storage(sparse)
component Damaged {
    amount_this_frame: float = 0.0
}
