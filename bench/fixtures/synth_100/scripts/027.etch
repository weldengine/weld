resource Cfg_27 { enabled: bool = true }

component Cmp_27_0 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_27_1 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_27_2 { f0: float = 0.0, f1: bool = true }

component Cmp_27_3 { f0: int = 0, f1: bool = true }

component Cmp_27_4 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_27_5 { f0: float = 0.0, f1: int = 0 }

component Cmp_27_6 { f0: float = 0.0, f1: bool = true }

component Cmp_27_7 { f0: float = 0.0, f1: bool = true }

component Cmp_27_8 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

rule rule_27_0(entity: Entity)
  when entity has Cmp_27_3 and resource Cfg_27
{
  entity.get_mut(Cmp_27_3).f0 += 1
}

rule rule_27_1(entity: Entity)
  when entity has Cmp_27_4 and entity has Cmp_27_6
{
  entity.get_mut(Cmp_27_4).f0 += 0.5
}

rule rule_27_2(entity: Entity)
  when entity has Cmp_27_6 and resource Cfg_27
{
  entity.get_mut(Cmp_27_6).f0 += 0.5
}

