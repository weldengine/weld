resource Cfg_8 { enabled: bool = true }

component Cmp_8_0 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_8_1 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_8_2 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_8_3 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_8_4 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_8_5 { f0: float = 0.0, f1: bool = true }

component Cmp_8_6 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

rule rule_8_0(entity: Entity)
  when entity has Cmp_8_5 and entity has Cmp_8_5 and resource Cfg_8
{
  entity.get_mut(Cmp_8_5).f0 += 0.5
}

rule rule_8_1(entity: Entity)
  when entity has Cmp_8_3 and entity has Cmp_8_2 and entity has Cmp_8_2 and resource Cfg_8
{
  entity.get_mut(Cmp_8_3).f0 += 1
}

rule rule_8_2(entity: Entity)
  when entity has Cmp_8_1 and entity has Cmp_8_4 and entity has Cmp_8_4
{
  entity.get_mut(Cmp_8_1).f0 += 0.5
}

rule rule_8_3(entity: Entity)
  when entity has Cmp_8_6 and entity has Cmp_8_4 and resource Cfg_8
{
  entity.get_mut(Cmp_8_6).f0 += 0.5
}

