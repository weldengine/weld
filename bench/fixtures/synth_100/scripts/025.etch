resource Cfg_25 { enabled: bool = true }

component Cmp_25_0 { f0: int = 0, f1: bool = true }

component Cmp_25_1 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_25_2 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_25_3 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_25_4 { f0: float = 0.0, f1: bool = true }

rule rule_25_0(entity: Entity)
  when entity has Cmp_25_3 and resource Cfg_25
{
  entity.get_mut(Cmp_25_3).f0 += 0.5
}

rule rule_25_1(entity: Entity)
  when entity has Cmp_25_2 and entity has Cmp_25_4 and entity has Cmp_25_1
{
  entity.get_mut(Cmp_25_2).f0 += 1
}

rule rule_25_2(entity: Entity)
  when entity has Cmp_25_1 and entity has Cmp_25_0 and resource Cfg_25
{
  entity.get_mut(Cmp_25_1).f0 += 1
}

rule rule_25_3(entity: Entity)
  when entity has Cmp_25_3 and entity has Cmp_25_4 and entity has Cmp_25_0 and resource Cfg_25
{
  entity.get_mut(Cmp_25_3).f0 += 0.5
}

