resource Cfg_75 { enabled: bool = true }

component Cmp_75_0 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_75_1 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_75_2 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_75_3 { f0: int = 0, f1: int = 0 }

component Cmp_75_4 { f0: float = 0.0, f1: int = 0 }

component Cmp_75_5 { f0: int = 0, f1: float = 0.0 }

component Cmp_75_6 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_75_7 { f0: int = 0, f1: bool = true }

component Cmp_75_8 { f0: int = 0, f1: bool = true, f2: int = 0 }

rule rule_75_0(entity: Entity)
  when entity has Cmp_75_6 and resource Cfg_75
{
  entity.get_mut(Cmp_75_6).f0 += 0.5
}

rule rule_75_1(entity: Entity)
  when entity has Cmp_75_7
{
  entity.get_mut(Cmp_75_7).f0 += 1
}

rule rule_75_2(entity: Entity)
  when entity has Cmp_75_1 and entity has Cmp_75_8
{
  entity.get_mut(Cmp_75_1).f0 += 0.5
}

