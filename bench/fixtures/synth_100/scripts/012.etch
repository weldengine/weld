resource Cfg_12 { enabled: bool = true }

component Cmp_12_0 { f0: int = 0, f1: int = 0, f2: bool = true }

component Cmp_12_1 { f0: int = 0, f1: float = 0.0 }

component Cmp_12_2 { f0: int = 0, f1: int = 0 }

component Cmp_12_3 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_12_4 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_12_5 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_12_6 { f0: int = 0, f1: bool = true }

component Cmp_12_7 { f0: int = 0, f1: bool = true }

component Cmp_12_8 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_12_9 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

rule rule_12_0(entity: Entity)
  when entity has Cmp_12_2 and entity has Cmp_12_8 and entity has Cmp_12_8
{
  entity.get_mut(Cmp_12_2).f0 += 1
}

rule rule_12_1(entity: Entity)
  when entity has Cmp_12_2
{
  entity.get_mut(Cmp_12_2).f0 += 1
}

rule rule_12_2(entity: Entity)
  when entity has Cmp_12_0 and entity has Cmp_12_0 and resource Cfg_12
{
  entity.get_mut(Cmp_12_0).f0 += 1
}

rule rule_12_3(entity: Entity)
  when entity has Cmp_12_3
{
  entity.get_mut(Cmp_12_3).f0 += 1
}

