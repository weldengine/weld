resource Cfg_19 { enabled: bool = true }

component Cmp_19_0 { f0: int = 0, f1: bool = true }

component Cmp_19_1 { f0: float = 0.0, f1: bool = true }

component Cmp_19_2 { f0: int = 0, f1: int = 0, f2: bool = true }

component Cmp_19_3 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_19_4 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

component Cmp_19_5 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

rule rule_19_0(entity: Entity)
  when entity has Cmp_19_1 and entity has Cmp_19_3 and resource Cfg_19
{
  entity.get_mut(Cmp_19_1).f0 += 0.5
}

rule rule_19_1(entity: Entity)
  when entity has Cmp_19_5 and entity has Cmp_19_4 and resource Cfg_19
{
  entity.get_mut(Cmp_19_5).f0 += 0.5
}

rule rule_19_2(entity: Entity)
  when entity has Cmp_19_4
{
  entity.get_mut(Cmp_19_4).f0 += 0.5
}

rule rule_19_3(entity: Entity)
  when entity has Cmp_19_3 and entity has Cmp_19_4 and resource Cfg_19
{
  entity.get_mut(Cmp_19_3).f0 += 0.5
}

