resource Cfg_47 { enabled: bool = true }

component Cmp_47_0 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_47_1 { f0: int = 0, f1: int = 0 }

component Cmp_47_2 { f0: int = 0, f1: int = 0 }

component Cmp_47_3 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_47_4 { f0: int = 0, f1: bool = true }

rule rule_47_0(entity: Entity)
  when entity has Cmp_47_1 and entity has Cmp_47_1 and resource Cfg_47
{
  entity.get_mut(Cmp_47_1).f0 += 1
}

rule rule_47_1(entity: Entity)
  when entity has Cmp_47_0 and entity has Cmp_47_1
{
  entity.get_mut(Cmp_47_0).f0 += 1
}

rule rule_47_2(entity: Entity)
  when entity has Cmp_47_0 and entity has Cmp_47_3 and entity has Cmp_47_0
{
  entity.get_mut(Cmp_47_0).f0 += 1
}

rule rule_47_3(entity: Entity)
  when entity has Cmp_47_3 and entity has Cmp_47_3 and entity has Cmp_47_0
{
  entity.get_mut(Cmp_47_3).f0 += 1
}

rule rule_47_4(entity: Entity)
  when entity has Cmp_47_2 and entity has Cmp_47_0 and resource Cfg_47
{
  entity.get_mut(Cmp_47_2).f0 += 1
}

