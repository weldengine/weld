resource Cfg_16 { enabled: bool = true }

component Cmp_16_0 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_16_1 { f0: float = 0.0, f1: int = 0 }

component Cmp_16_2 { f0: float = 0.0, f1: int = 0 }

component Cmp_16_3 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_16_4 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_16_5 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_16_6 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_16_7 { f0: float = 0.0, f1: int = 0 }

component Cmp_16_8 { f0: int = 0, f1: float = 0.0 }

component Cmp_16_9 { f0: float = 0.0, f1: int = 0 }

rule rule_16_0(entity: Entity)
  when entity has Cmp_16_9 and entity has Cmp_16_7 and resource Cfg_16
{
  entity.get_mut(Cmp_16_9).f0 += 0.5
}

rule rule_16_1(entity: Entity)
  when entity has Cmp_16_1 and entity has Cmp_16_0
{
  entity.get_mut(Cmp_16_1).f0 += 0.5
}

rule rule_16_2(entity: Entity)
  when entity has Cmp_16_0 and resource Cfg_16
{
  entity.get_mut(Cmp_16_0).f0 += 0.5
}

