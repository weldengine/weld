resource Cfg_63 { enabled: bool = true }

component Cmp_63_0 { f0: float = 0.0, f1: bool = true }

component Cmp_63_1 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_63_2 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_63_3 { f0: int = 0, f1: float = 0.0 }

component Cmp_63_4 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_63_5 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_63_6 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_63_7 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_63_8 { f0: int = 0, f1: int = 0 }

rule rule_63_0(entity: Entity)
  when entity has Cmp_63_7
{
  entity.get_mut(Cmp_63_7).f0 += 1
}

rule rule_63_1(entity: Entity)
  when entity has Cmp_63_6 and entity has Cmp_63_6 and entity has Cmp_63_3 and resource Cfg_63
{
  entity.get_mut(Cmp_63_6).f0 += 1
}

rule rule_63_2(entity: Entity)
  when entity has Cmp_63_2 and resource Cfg_63
{
  entity.get_mut(Cmp_63_2).f0 += 0.5
}

rule rule_63_3(entity: Entity)
  when entity has Cmp_63_8
{
  entity.get_mut(Cmp_63_8).f0 += 1
}

