resource Cfg_2 { enabled: bool = true }

component Cmp_2_0 { f0: float = 0.0, f1: int = 0 }

component Cmp_2_1 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_2_2 { f0: float = 0.0, f1: int = 0 }

component Cmp_2_3 { f0: int = 0, f1: int = 0, f2: bool = true }

component Cmp_2_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_2_5 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_2_6 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_2_7 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_2_8 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_2_9 { f0: float = 0.0, f1: float = 0.0 }

rule rule_2_0(entity: Entity)
  when entity has Cmp_2_2 and resource Cfg_2
{
  entity.get_mut(Cmp_2_2).f0 += 0.5
}

rule rule_2_1(entity: Entity)
  when entity has Cmp_2_6 and resource Cfg_2
{
  entity.get_mut(Cmp_2_6).f0 += 1
}

rule rule_2_2(entity: Entity)
  when entity has Cmp_2_6
{
  entity.get_mut(Cmp_2_6).f0 += 1
}

rule rule_2_3(entity: Entity)
  when entity has Cmp_2_8
{
  entity.get_mut(Cmp_2_8).f0 += 0.5
}

rule rule_2_4(entity: Entity)
  when entity has Cmp_2_6 and entity has Cmp_2_9 and entity has Cmp_2_3
{
  entity.get_mut(Cmp_2_6).f0 += 1
}

