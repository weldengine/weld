resource Cfg_28 { enabled: bool = true }

component Cmp_28_0 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_28_1 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_28_2 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_28_3 { f0: int = 0, f1: float = 0.0 }

component Cmp_28_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_28_5 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_28_6 { f0: float = 0.0, f1: int = 0 }

component Cmp_28_7 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_28_8 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_28_9 { f0: float = 0.0, f1: int = 0 }

rule rule_28_0(entity: Entity)
  when entity has Cmp_28_1 and entity has Cmp_28_8 and entity has Cmp_28_5 and resource Cfg_28
{
  entity.get_mut(Cmp_28_1).f0 += 0.5
}

rule rule_28_1(entity: Entity)
  when entity has Cmp_28_0 and entity has Cmp_28_4
{
  entity.get_mut(Cmp_28_0).f0 += 0.5
}

rule rule_28_2(entity: Entity)
  when entity has Cmp_28_8 and entity has Cmp_28_4 and entity has Cmp_28_0
{
  entity.get_mut(Cmp_28_8).f0 += 0.5
}

rule rule_28_3(entity: Entity)
  when entity has Cmp_28_9 and entity has Cmp_28_0 and entity has Cmp_28_6
{
  entity.get_mut(Cmp_28_9).f0 += 0.5
}

rule rule_28_4(entity: Entity)
  when entity has Cmp_28_5 and entity has Cmp_28_8 and resource Cfg_28
{
  entity.get_mut(Cmp_28_5).f0 += 0.5
}

