resource Cfg_31 { enabled: bool = true }

component Cmp_31_0 { f0: int = 0, f1: int = 0 }

component Cmp_31_1 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_31_2 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_31_3 { f0: int = 0, f1: float = 0.0 }

component Cmp_31_4 { f0: int = 0, f1: bool = true, f2: int = 0 }

rule rule_31_0(entity: Entity)
  when entity has Cmp_31_3 and entity has Cmp_31_0 and entity has Cmp_31_1 and resource Cfg_31
{
  entity.get_mut(Cmp_31_3).f0 += 1
}

rule rule_31_1(entity: Entity)
  when entity has Cmp_31_0
{
  entity.get_mut(Cmp_31_0).f0 += 1
}

rule rule_31_2(entity: Entity)
  when entity has Cmp_31_0 and entity has Cmp_31_2 and entity has Cmp_31_1 and resource Cfg_31
{
  entity.get_mut(Cmp_31_0).f0 += 1
}

rule rule_31_3(entity: Entity)
  when entity has Cmp_31_1 and entity has Cmp_31_2 and entity has Cmp_31_4 and resource Cfg_31
{
  entity.get_mut(Cmp_31_1).f0 += 0.5
}

