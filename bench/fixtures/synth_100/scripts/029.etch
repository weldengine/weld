resource Cfg_29 { enabled: bool = true }

component Cmp_29_0 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_29_1 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_29_2 { f0: int = 0, f1: bool = true }

component Cmp_29_3 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_29_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_29_5 { f0: float = 0.0, f1: int = 0 }

component Cmp_29_6 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

rule rule_29_0(entity: Entity)
  when entity has Cmp_29_2 and entity has Cmp_29_4 and entity has Cmp_29_1
{
  entity.get_mut(Cmp_29_2).f0 += 1
}

rule rule_29_1(entity: Entity)
  when entity has Cmp_29_1 and entity has Cmp_29_3 and entity has Cmp_29_0
{
  entity.get_mut(Cmp_29_1).f0 += 0.5
}

rule rule_29_2(entity: Entity)
  when entity has Cmp_29_6 and entity has Cmp_29_5 and entity has Cmp_29_3
{
  entity.get_mut(Cmp_29_6).f0 += 0.5
}

