rule rule_98_0(entity: Entity)
  when entity has Cmp_98_6 and resource Cfg_98
{
  entity.get_mut(Cmp_98_6).f0 += 1
}

rule rule_98_1(entity: Entity)
  when entity has Cmp_98_5
{
  entity.get_mut(Cmp_98_5).f0 += 1
