resource Cfg_45 { enabled: bool = true }

component Cmp_45_0 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_45_1 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_45_2 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_45_3 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_45_4 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_45_5 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_45_6 { f0: float = 0.0, f1: int = 0 }

component Cmp_45_7 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_45_8 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

rule rule_45_0(entity: Entity)
  when entity has Cmp_45_1 and resource Cfg_45
{
  entity.get_mut(Cmp_45_1).f0 += 1
}

rule rule_45_1(entity: Entity)
  when entity has Cmp_45_3 and resource Cfg_45
{
  entity.get_mut(Cmp_45_3).f0 += 0.5
}

rule rule_45_2(entity: Entity)
  when entity has Cmp_45_6 and entity has Cmp_45_3 and entity has Cmp_45_4 and resource Cfg_45
{
  entity.get_mut(Cmp_45_6).f0 += 0.5
}

rule rule_45_3(entity: Entity)
  when entity has Cmp_45_7
{
  entity.get_mut(Cmp_45_7).f0 += 1
}

