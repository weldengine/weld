resource Cfg_41 { enabled: bool = true }

component Cmp_41_0 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_41_1 { f0: int = 0, f1: bool = true }

component Cmp_41_2 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_41_3 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_41_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_41_5 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_41_6 { f0: int = 0, f1: float = 0.0 }

component Cmp_41_7 { f0: int = 0, f1: float = 0.0 }

rule rule_41_0(entity: Entity)
  when entity has Cmp_41_4 and entity has Cmp_41_1 and entity has Cmp_41_5 and resource Cfg_41
{
  entity.get_mut(Cmp_41_4).f0 += 1
}

rule rule_41_1(entity: Entity)
  when entity has Cmp_41_3
{
  entity.get_mut(Cmp_41_3).f0 += 1
}

rule rule_41_2(entity: Entity)
  when entity has Cmp_41_2 and entity has Cmp_41_5 and entity has Cmp_41_3 and resource Cfg_41
{
  entity.get_mut(Cmp_41_2).f0 += 0.5
}

rule rule_41_3(entity: Entity)
  when entity has Cmp_41_1 and entity has Cmp_41_4 and entity has Cmp_41_7
{
  entity.get_mut(Cmp_41_1).f0 += 1
}

