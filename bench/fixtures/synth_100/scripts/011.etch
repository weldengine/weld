resource Cfg_11 { enabled: bool = true }

component Cmp_11_0 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_11_1 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_11_2 { f0: int = 0, f1: int = 0, f2: bool = true }

component Cmp_11_3 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_11_4 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_11_5 { f0: float = 0.0, f1: bool = true }

rule rule_11_0(entity: Entity)
  when entity has Cmp_11_5 and entity has Cmp_11_0 and entity has Cmp_11_1
{
  entity.get_mut(Cmp_11_5).f0 += 0.5
}

rule rule_11_1(entity: Entity)
  when entity has Cmp_11_3 and entity has Cmp_11_2 and resource Cfg_11
{
  entity.get_mut(Cmp_11_3).f0 += 0.5
}

rule rule_11_2(entity: Entity)
  when entity has Cmp_11_1 and resource Cfg_11
{
  entity.get_mut(Cmp_11_1).f0 += 0.5
}

rule rule_11_3(entity: Entity)
  when entity has Cmp_11_1 and entity has Cmp_11_0 and entity has Cmp_11_2 and resource Cfg_11
{
  entity.get_mut(Cmp_11_1).f0 += 0.5
}

