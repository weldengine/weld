resource Cfg_0 { enabled: bool = true }

component Cmp_0_0 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_0_1 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_0_2 { f0: float = 0.0, f1: bool = true }

component Cmp_0_3 { f0: int = 0, f1: int = 0 }

component Cmp_0_4 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_0_5 { f0: int = 0, f1: float = 0.0 }

rule rule_0_0(entity: Entity)
  when entity has Cmp_0_5 and entity has Cmp_0_4 and entity has Cmp_0_1 and resource Cfg_0
{
  entity.get_mut(Cmp_0_5).f0 += 1
}

rule rule_0_1(entity: Entity)
  when entity has Cmp_0_2 and resource Cfg_0
{
  entity.get_mut(Cmp_0_2).f0 += 0.5
}

rule rule_0_2(entity: Entity)
  when entity has Cmp_0_1 and entity has Cmp_0_4 and resource Cfg_0
{
  entity.get_mut(Cmp_0_1).f0 += 1
}

rule rule_0_3(entity: Entity)
  when entity has Cmp_0_0 and entity has Cmp_0_0 and entity has Cmp_0_5
{
  entity.get_mut(Cmp_0_0).f0 += 0.5
}

rule rule_0_4(entity: Entity)
  when entity has Cmp_0_3
{
  entity.get_mut(Cmp_0_3).f0 += 1
}

