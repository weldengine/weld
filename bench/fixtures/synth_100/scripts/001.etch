resource Cfg_1 { enabled: bool = true }

component Cmp_1_0 { f0: int = 0, f1: float = 0.0 }

component Cmp_1_1 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_1_2 { f0: int = 0, f1: int = 0 }

component Cmp_1_3 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_1_4 { f0: float = 0.0, f1: bool = true }

component Cmp_1_5 { f0: int = 0, f1: float = 0.0 }

rule rule_1_0(entity: Entity)
  when entity has Cmp_1_4 and entity has Cmp_1_1
{
  entity.get_mut(Cmp_1_4).f0 += 0.5
}

rule rule_1_1(entity: Entity)
  when entity has Cmp_1_4 and entity has Cmp_1_3 and resource Cfg_1
{
  entity.get_mut(Cmp_1_4).f0 += 0.5
}

rule rule_1_2(entity: Entity)
  when entity has Cmp_1_2
{
  entity.get_mut(Cmp_1_2).f0 += 1
}

rule rule_1_3(entity: Entity)
  when entity has Cmp_1_2 and entity has Cmp_1_0
{
  entity.get_mut(Cmp_1_2).f0 += 1
}

