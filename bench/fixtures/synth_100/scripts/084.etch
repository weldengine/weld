resource Cfg_84 { enabled: bool = true }

component Cmp_84_0 { f0: int = 0, f1: int = 0 }

component Cmp_84_1 { f0: int = 0, f1: float = 0.0 }

component Cmp_84_2 { f0: float = 0.0, f1: int = 0 }

component Cmp_84_3 { f0: int = 0, f1: float = 0.0 }

component Cmp_84_4 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

rule rule_84_0(entity: Entity)
  when entity has Cmp_84_3 and entity has Cmp_84_0 and entity has Cmp_84_1 and resource Cfg_84
{
  entity.get_mut(Cmp_84_3).f0 += 1
}

rule rule_84_1(entity: Entity)
  when entity has Cmp_84_3 and entity has Cmp_84_1 and resource Cfg_84
{
  entity.get_mut(Cmp_84_3).f0 += 1
}

rule rule_84_2(entity: Entity)
  when entity has Cmp_84_0 and entity has Cmp_84_3 and entity has Cmp_84_1 and resource Cfg_84
{
  entity.get_mut(Cmp_84_0).f0 += 1
}

rule rule_84_3(entity: Entity)
  when entity has Cmp_84_3 and entity has Cmp_84_3
{
  entity.get_mut(Cmp_84_3).f0 += 1
}

