resource Cfg_38 { enabled: bool = true }

component Cmp_38_0 { f0: int = 0, f1: float = 0.0 }

component Cmp_38_1 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_38_2 { f0: int = 0, f1: bool = true }

component Cmp_38_3 { f0: int = 0, f1: bool = true }

component Cmp_38_4 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_38_5 { f0: int = 0, f1: int = 0 }

rule rule_38_0(entity: Entity)
  when entity has Cmp_38_5
{
  entity.get_mut(Cmp_38_5).f0 += 1
}

rule rule_38_1(entity: Entity)
  when entity has Cmp_38_0 and entity has Cmp_38_2
{
  entity.get_mut(Cmp_38_0).f0 += 1
}

rule rule_38_2(entity: Entity)
  when entity has Cmp_38_3
{
  entity.get_mut(Cmp_38_3).f0 += 1
}

