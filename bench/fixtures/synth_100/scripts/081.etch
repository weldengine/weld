resource Cfg_81 { enabled: bool = true }

component Cmp_81_0 { f0: int = 0, f1: float = 0.0 }

component Cmp_81_1 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_81_2 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_81_3 { f0: int = 0, f1: bool = true }

component Cmp_81_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_81_5 { f0: float = 0.0, f1: bool = true }

component Cmp_81_6 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_81_7 { f0: int = 0, f1: float = 0.0 }

component Cmp_81_8 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_81_9 { f0: float = 0.0, f1: int = 0 }

rule rule_81_0(entity: Entity)
  when entity has Cmp_81_1 and resource Cfg_81
{
  entity.get_mut(Cmp_81_1).f0 += 0.5
}

rule rule_81_1(entity: Entity)
  when entity has Cmp_81_0 and entity has Cmp_81_6
{
  entity.get_mut(Cmp_81_0).f0 += 1
}

rule rule_81_2(entity: Entity)
  when entity has Cmp_81_2 and entity has Cmp_81_1
{
  entity.get_mut(Cmp_81_2).f0 += 0.5
}

rule rule_81_3(entity: Entity)
  when entity has Cmp_81_8 and resource Cfg_81
{
  entity.get_mut(Cmp_81_8).f0 += 0.5
}

