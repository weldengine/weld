resource Cfg_80 { enabled: bool = true }

component Cmp_80_0 { f0: int = 0, f1: int = 0 }

component Cmp_80_1 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_80_2 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_80_3 { f0: int = 0, f1: float = 0.0 }

component Cmp_80_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_80_5 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_80_6 { f0: float = 0.0, f1: bool = true }

component Cmp_80_7 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_80_8 { f0: int = 0, f1: int = 0 }

component Cmp_80_9 { f0: float = 0.0, f1: int = 0, f2: bool = true }

rule rule_80_0(entity: Entity)
  when entity has Cmp_80_4 and entity has Cmp_80_0 and resource Cfg_80
{
  entity.get_mut(Cmp_80_4).f0 += 1
}

rule rule_80_1(entity: Entity)
  when entity has Cmp_80_8 and entity has Cmp_80_4
{
  entity.get_mut(Cmp_80_8).f0 += 1
}

rule rule_80_2(entity: Entity)
  when entity has Cmp_80_5 and entity has Cmp_80_3 and entity has Cmp_80_6
{
  entity.get_mut(Cmp_80_5).f0 += 0.5
}

rule rule_80_3(entity: Entity)
  when entity has Cmp_80_6 and resource Cfg_80
{
  entity.get_mut(Cmp_80_6).f0 += 0.5
}

