resource Cfg_78 { enabled: bool = true }

component Cmp_78_0 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_78_1 { f0: float = 0.0, f1: bool = true }

component Cmp_78_2 { f0: int = 0, f1: int = 0, f2: bool = true }

component Cmp_78_3 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_78_4 { f0: int = 0, f1: int = 0, f2: bool = true }

rule rule_78_0(entity: Entity)
  when entity has Cmp_78_3 and entity has Cmp_78_2
{
  entity.get_mut(Cmp_78_3).f0 += 0.5
}

rule rule_78_1(entity: Entity)
  when entity has Cmp_78_3 and resource Cfg_78
{
  entity.get_mut(Cmp_78_3).f0 += 0.5
}

rule rule_78_2(entity: Entity)
  when entity has Cmp_78_2 and entity has Cmp_78_2 and entity has Cmp_78_2 and resource Cfg_78
{
  entity.get_mut(Cmp_78_2).f0 += 1
}

