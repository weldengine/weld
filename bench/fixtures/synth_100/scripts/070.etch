resource Cfg_70 { enabled: bool = true }

component Cmp_70_0 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_70_1 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_70_2 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_70_3 { f0: float = 0.0, f1: int = 0 }

component Cmp_70_4 { f0: float = 0.0, f1: bool = true }

component Cmp_70_5 { f0: int = 0, f1: float = 0.0 }

component Cmp_70_6 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_70_7 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_70_8 { f0: float = 0.0, f1: int = 0 }

rule rule_70_0(entity: Entity)
  when entity has Cmp_70_7 and resource Cfg_70
{
  entity.get_mut(Cmp_70_7).f0 += 0.5
}

rule rule_70_1(entity: Entity)
  when entity has Cmp_70_6 and entity has Cmp_70_8
{
  entity.get_mut(Cmp_70_6).f0 += 0.5
}

rule rule_70_2(entity: Entity)
  when entity has Cmp_70_2 and entity has Cmp_70_3
{
  entity.get_mut(Cmp_70_2).f0 += 1
}

rule rule_70_3(entity: Entity)
  when entity has Cmp_70_0 and entity has Cmp_70_7 and resource Cfg_70
{
  entity.get_mut(Cmp_70_0).f0 += 0.5
}

