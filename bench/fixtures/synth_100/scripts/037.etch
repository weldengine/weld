resource Cfg_37 { enabled: bool = true }

component Cmp_37_0 { f0: float = 0.0, f1: bool = true }

component Cmp_37_1 { f0: int = 0, f1: int = 0 }

component Cmp_37_2 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_37_3 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_37_4 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_37_5 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_37_6 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_37_7 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_37_8 { f0: float = 0.0, f1: float = 0.0 }

rule rule_37_0(entity: Entity)
  when entity has Cmp_37_8 and entity has Cmp_37_5 and entity has Cmp_37_8
{
  entity.get_mut(Cmp_37_8).f0 += 0.5
}

rule rule_37_1(entity: Entity)
  when entity has Cmp_37_1
{
  entity.get_mut(Cmp_37_1).f0 += 1
}

rule rule_37_2(entity: Entity)
  when entity has Cmp_37_2 and entity has Cmp_37_5 and entity has Cmp_37_0
{
  entity.get_mut(Cmp_37_2).f0 += 1
}

rule rule_37_3(entity: Entity)
  when entity has Cmp_37_1 and entity has Cmp_37_6 and resource Cfg_37
{
  entity.get_mut(Cmp_37_1).f0 += 1
}

