resource Cfg_39 { enabled: bool = true }

component Cmp_39_0 { f0: int = 0, f1: float = 0.0 }

component Cmp_39_1 { f0: int = 0, f1: bool = true }

component Cmp_39_2 { f0: float = 0.0, f1: int = 0 }

component Cmp_39_3 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_39_4 { f0: int = 0, f1: int = 0 }

component Cmp_39_5 { f0: int = 0, f1: bool = true }

component Cmp_39_6 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_39_7 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

rule rule_39_0(entity: Entity)
  when entity has Cmp_39_2 and resource Cfg_39
{
  entity.get_mut(Cmp_39_2).f0 += 0.5
}

rule rule_39_1(entity: Entity)
  when entity has Cmp_39_5 and entity has Cmp_39_6 and entity has Cmp_39_2
{
  entity.get_mut(Cmp_39_5).f0 += 1
}

rule rule_39_2(entity: Entity)
  when entity has Cmp_39_6
{
  entity.get_mut(Cmp_39_6).f0 += 0.5
}

rule rule_39_3(entity: Entity)
  when entity has Cmp_39_0 and entity has Cmp_39_4
{
  entity.get_mut(Cmp_39_0).f0 += 1
}

rule rule_39_4(entity: Entity)
  when entity has Cmp_39_7 and entity has Cmp_39_7 and entity has Cmp_39_3
{
  entity.get_mut(Cmp_39_7).f0 += 0.5
}

