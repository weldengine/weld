resource Cfg_50 { enabled: bool = true }

component Cmp_50_0 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_50_1 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_50_2 { f0: float = 0.0, f1: bool = true }

component Cmp_50_3 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_50_4 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_50_5 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_50_6 { f0: int = 0, f1: float = 0.0 }

rule rule_50_0(entity: Entity)
  when entity has Cmp_50_1
{
  entity.get_mut(Cmp_50_1).f0 += 1
}

rule rule_50_1(entity: Entity)
  when entity has Cmp_50_1
{
  entity.get_mut(Cmp_50_1).f0 += 1
}

rule rule_50_2(entity: Entity)
  when entity has Cmp_50_6
{
  entity.get_mut(Cmp_50_6).f0 += 1
}

