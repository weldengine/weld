resource Cfg_26 { enabled: bool = true }

component Cmp_26_0 { f0: int = 0, f1: float = 0.0 }

component Cmp_26_1 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

component Cmp_26_2 { f0: int = 0, f1: int = 0 }

component Cmp_26_3 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_26_4 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_26_5 { f0: float = 0.0, f1: int = 0 }

component Cmp_26_6 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

rule rule_26_0(entity: Entity)
  when entity has Cmp_26_4 and entity has Cmp_26_2 and entity has Cmp_26_3 and resource Cfg_26
{
  entity.get_mut(Cmp_26_4).f0 += 1
}

rule rule_26_1(entity: Entity)
  when entity has Cmp_26_1 and entity has Cmp_26_3 and entity has Cmp_26_0 and resource Cfg_26
{
  entity.get_mut(Cmp_26_1).f0 += 0.5
}

rule rule_26_2(entity: Entity)
  when entity has Cmp_26_5 and entity has Cmp_26_5
{
  entity.get_mut(Cmp_26_5).f0 += 0.5
}

