resource Cfg_86 { enabled: bool = true }

component Cmp_86_0 { f0: float = 0.0, f1: int = 0 }

component Cmp_86_1 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_86_2 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_86_3 { f0: int = 0, f1: bool = true }

component Cmp_86_4 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_86_5 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_86_6 { f0: int = 0, f1: bool = true }

rule rule_86_0(entity: Entity)
  when entity has Cmp_86_4 and entity has Cmp_86_5 and entity has Cmp_86_1
{
  entity.get_mut(Cmp_86_4).f0 += 0.5
}

rule rule_86_1(entity: Entity)
  when entity has Cmp_86_3 and entity has Cmp_86_3 and entity has Cmp_86_6
{
  entity.get_mut(Cmp_86_3).f0 += 1
}

rule rule_86_2(entity: Entity)
  when entity has Cmp_86_1 and entity has Cmp_86_6
{
  entity.get_mut(Cmp_86_1).f0 += 0.5
}

rule rule_86_3(entity: Entity)
  when entity has Cmp_86_2
{
  entity.get_mut(Cmp_86_2).f0 += 0.5
}

