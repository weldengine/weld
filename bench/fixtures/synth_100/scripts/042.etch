resource Cfg_42 { enabled: bool = true }

component Cmp_42_0 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_42_1 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_42_2 { f0: int = 0, f1: bool = true }

component Cmp_42_3 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_42_4 { f0: int = 0, f1: bool = true }

component Cmp_42_5 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_42_6 { f0: int = 0, f1: int = 0 }

component Cmp_42_7 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

rule rule_42_0(entity: Entity)
  when entity has Cmp_42_1 and entity has Cmp_42_4 and entity has Cmp_42_7 and resource Cfg_42
{
  entity.get_mut(Cmp_42_1).f0 += 1
}

rule rule_42_1(entity: Entity)
  when entity has Cmp_42_7 and entity has Cmp_42_2 and entity has Cmp_42_4 and resource Cfg_42
{
  entity.get_mut(Cmp_42_7).f0 += 0.5
}

rule rule_42_2(entity: Entity)
  when entity has Cmp_42_6 and entity has Cmp_42_7 and entity has Cmp_42_2
{
  entity.get_mut(Cmp_42_6).f0 += 1
}

rule rule_42_3(entity: Entity)
  when entity has Cmp_42_5 and entity has Cmp_42_2 and entity has Cmp_42_0
{
  entity.get_mut(Cmp_42_5).f0 += 0.5
}

