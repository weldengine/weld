resource Cfg_9 { enabled: bool = true }

component Cmp_9_0 { f0: float = 0.0, f1: int = 0 }

component Cmp_9_1 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_9_2 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_9_3 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_9_4 { f0: int = 0, f1: bool = true }

component Cmp_9_5 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_9_6 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_9_7 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_9_8 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

rule rule_9_0(entity: Entity)
  when entity has Cmp_9_6
{
  entity.get_mut(Cmp_9_6).f0 += 0.5
}

rule rule_9_1(entity: Entity)
  when entity has Cmp_9_6 and entity has Cmp_9_6
{
  entity.get_mut(Cmp_9_6).f0 += 0.5
}

rule rule_9_2(entity: Entity)
  when entity has Cmp_9_5 and entity has Cmp_9_3 and entity has Cmp_9_0
{
  entity.get_mut(Cmp_9_5).f0 += 1
}

