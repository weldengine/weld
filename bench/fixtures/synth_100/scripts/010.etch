resource Cfg_10 { enabled: bool = true }

component Cmp_10_0 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_10_1 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_10_2 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_10_3 { f0: int = 0, f1: int = 0 }

component Cmp_10_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_10_5 { f0: int = 0, f1: float = 0.0, f2: bool = true }

rule rule_10_0(entity: Entity)
  when entity has Cmp_10_2 and entity has Cmp_10_1 and resource Cfg_10
{
  entity.get_mut(Cmp_10_2).f0 += 0.5
}

rule rule_10_1(entity: Entity)
  when entity has Cmp_10_4 and entity has Cmp_10_1
{
  entity.get_mut(Cmp_10_4).f0 += 1
}

rule rule_10_2(entity: Entity)
  when entity has Cmp_10_0
{
  entity.get_mut(Cmp_10_0).f0 += 0.5
}

