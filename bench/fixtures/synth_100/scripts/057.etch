resource Cfg_57 { enabled: bool = true }

component Cmp_57_0 { f0: int = 0, f1: bool = true }

component Cmp_57_1 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_57_2 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_57_3 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_57_4 { f0: float = 0.0, f1: bool = true, f2: bool = true }

rule rule_57_0(entity: Entity)
  when entity has Cmp_57_3 and entity has Cmp_57_2 and entity has Cmp_57_4 and resource Cfg_57
{
  entity.get_mut(Cmp_57_3).f0 += 1
}

rule rule_57_1(entity: Entity)
  when entity has Cmp_57_4 and entity has Cmp_57_3
{
  entity.get_mut(Cmp_57_4).f0 += 0.5
}

rule rule_57_2(entity: Entity)
  when entity has Cmp_57_1
{
  entity.get_mut(Cmp_57_1).f0 += 0.5
}

