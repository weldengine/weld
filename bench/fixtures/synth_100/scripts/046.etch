resource Cfg_46 { enabled: bool = true }

component Cmp_46_0 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_46_1 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_46_2 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_46_3 { f0: float = 0.0, f1: int = 0 }

component Cmp_46_4 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_46_5 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

rule rule_46_0(entity: Entity)
  when entity has Cmp_46_3 and entity has Cmp_46_5 and entity has Cmp_46_0
{
  entity.get_mut(Cmp_46_3).f0 += 0.5
}

rule rule_46_1(entity: Entity)
  when entity has Cmp_46_4 and entity has Cmp_46_5 and resource Cfg_46
{
  entity.get_mut(Cmp_46_4).f0 += 0.5
}

rule rule_46_2(entity: Entity)
  when entity has Cmp_46_1 and entity has Cmp_46_4 and resource Cfg_46
{
  entity.get_mut(Cmp_46_1).f0 += 1
}

rule rule_46_3(entity: Entity)
  when entity has Cmp_46_5 and resource Cfg_46
{
  entity.get_mut(Cmp_46_5).f0 += 0.5
}

rule rule_46_4(entity: Entity)
  when entity has Cmp_46_5 and entity has Cmp_46_0
{
  entity.get_mut(Cmp_46_5).f0 += 0.5
}

