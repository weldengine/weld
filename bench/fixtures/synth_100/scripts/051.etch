resource Cfg_51 { enabled: bool = true }

component Cmp_51_0 { f0: float = 0.0, f1: bool = true }

component Cmp_51_1 { f0: float = 0.0, f1: bool = true }

component Cmp_51_2 { f0: float = 0.0, f1: int = 0 }

component Cmp_51_3 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_51_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_51_5 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

component Cmp_51_6 { f0: int = 0, f1: bool = true }

component Cmp_51_7 { f0: int = 0, f1: float = 0.0 }

component Cmp_51_8 { f0: float = 0.0, f1: int = 0, f2: bool = true }

rule rule_51_0(entity: Entity)
  when entity has Cmp_51_5 and entity has Cmp_51_1 and entity has Cmp_51_3
{
  entity.get_mut(Cmp_51_5).f0 += 0.5
}

rule rule_51_1(entity: Entity)
  when entity has Cmp_51_8 and entity has Cmp_51_6 and entity has Cmp_51_3 and resource Cfg_51
{
  entity.get_mut(Cmp_51_8).f0 += 0.5
}

rule rule_51_2(entity: Entity)
  when entity has Cmp_51_3 and entity has Cmp_51_5 and entity has Cmp_51_5 and resource Cfg_51
{
  entity.get_mut(Cmp_51_3).f0 += 0.5
}

rule rule_51_3(entity: Entity)
  when entity has Cmp_51_4 and entity has Cmp_51_8 and entity has Cmp_51_4 and resource Cfg_51
{
  entity.get_mut(Cmp_51_4).f0 += 1
}

