resource Cfg_64 { enabled: bool = true }

component Cmp_64_0 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_64_1 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_64_2 { f0: int = 0, f1: bool = true }

component Cmp_64_3 { f0: float = 0.0, f1: int = 0 }

component Cmp_64_4 { f0: float = 0.0, f1: bool = true }

component Cmp_64_5 { f0: int = 0, f1: int = 0 }

rule rule_64_0(entity: Entity)
  when entity has Cmp_64_0
{
  entity.get_mut(Cmp_64_0).f0 += 0.5
}

rule rule_64_1(entity: Entity)
  when entity has Cmp_64_5
{
  entity.get_mut(Cmp_64_5).f0 += 1
}

rule rule_64_2(entity: Entity)
  when entity has Cmp_64_5 and entity has Cmp_64_2
{
  entity.get_mut(Cmp_64_5).f0 += 1
}

