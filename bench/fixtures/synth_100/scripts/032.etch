resource Cfg_32 { enabled: bool = true }

component Cmp_32_0 { f0: float = 0.0, f1: bool = true }

component Cmp_32_1 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_32_2 { f0: int = 0, f1: int = 0, f2: bool = true }

component Cmp_32_3 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_32_4 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_32_5 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_32_6 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

rule rule_32_0(entity: Entity)
  when entity has Cmp_32_2 and resource Cfg_32
{
  entity.get_mut(Cmp_32_2).f0 += 1
}

rule rule_32_1(entity: Entity)
  when entity has Cmp_32_5 and entity has Cmp_32_2
{
  entity.get_mut(Cmp_32_5).f0 += 1
}

rule rule_32_2(entity: Entity)
  when entity has Cmp_32_4 and entity has Cmp_32_1 and entity has Cmp_32_4
{
  entity.get_mut(Cmp_32_4).f0 += 0.5
}

rule rule_32_3(entity: Entity)
  when entity has Cmp_32_0 and resource Cfg_32
{
  entity.get_mut(Cmp_32_0).f0 += 0.5
}

