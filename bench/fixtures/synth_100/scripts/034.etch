resource Cfg_34 { enabled: bool = true }

component Cmp_34_0 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_34_1 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_34_2 { f0: int = 0, f1: float = 0.0 }

component Cmp_34_3 { f0: int = 0, f1: float = 0.0 }

component Cmp_34_4 { f0: float = 0.0, f1: bool = true }

component Cmp_34_5 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_34_6 { f0: float = 0.0, f1: bool = true }

component Cmp_34_7 { f0: float = 0.0, f1: int = 0 }

component Cmp_34_8 { f0: int = 0, f1: int = 0, f2: bool = true }

component Cmp_34_9 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

rule rule_34_0(entity: Entity)
  when entity has Cmp_34_9 and entity has Cmp_34_7 and entity has Cmp_34_9
{
  entity.get_mut(Cmp_34_9).f0 += 0.5
}

rule rule_34_1(entity: Entity)
  when entity has Cmp_34_3 and entity has Cmp_34_5
{
  entity.get_mut(Cmp_34_3).f0 += 1
}

rule rule_34_2(entity: Entity)
  when entity has Cmp_34_3 and entity has Cmp_34_5 and resource Cfg_34
{
  entity.get_mut(Cmp_34_3).f0 += 1
}

