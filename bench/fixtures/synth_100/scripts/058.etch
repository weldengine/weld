resource Cfg_58 { enabled: bool = true }

component Cmp_58_0 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_58_1 { f0: int = 0, f1: float = 0.0 }

component Cmp_58_2 { f0: int = 0, f1: int = 0 }

component Cmp_58_3 { f0: int = 0, f1: float = 0.0 }

component Cmp_58_4 { f0: int = 0, f1: bool = true }

component Cmp_58_5 { f0: int = 0, f1: int = 0 }

component Cmp_58_6 { f0: int = 0, f1: int = 0 }

component Cmp_58_7 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_58_8 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

rule rule_58_0(entity: Entity)
  when entity has Cmp_58_2 and resource Cfg_58
{
  entity.get_mut(Cmp_58_2).f0 += 1
}

rule rule_58_1(entity: Entity)
  when entity has Cmp_58_1
{
  entity.get_mut(Cmp_58_1).f0 += 1
}

rule rule_58_2(entity: Entity)
  when entity has Cmp_58_6
{
  entity.get_mut(Cmp_58_6).f0 += 1
