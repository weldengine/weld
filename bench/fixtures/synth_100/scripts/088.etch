resource Cfg_88 { enabled: bool = true }

component Cmp_88_0 { f0: int = 0, f1: int = 0 }

component Cmp_88_1 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_88_2 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_88_3 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_88_4 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

component Cmp_88_5 { f0: float = 0.0, f1: int = 0 }

component Cmp_88_6 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_88_7 { f0: int = 0, f1: int = 0, f2: int = 0 }

component Cmp_88_8 { f0: float = 0.0, f1: float = 0.0 }

rule rule_88_0(entity: Entity)
  when entity has Cmp_88_8 and entity has Cmp_88_1 and entity has Cmp_88_6 and resource Cfg_88
{
  entity.get_mut(Cmp_88_8).f0 += 0.5
}

rule rule_88_1(entity: Entity)
  when entity has Cmp_88_6 and entity has Cmp_88_8 and entity has Cmp_88_5
{
  entity.get_mut(Cmp_88_6).f0 += 0.5
}

rule rule_88_2(entity: Entity)
  when entity has Cmp_88_4 and entity has Cmp_88_1
{
  entity.get_mut(Cmp_88_4).f0 += 0.5
}

rule rule_88_3(entity: Entity)
  when entity has Cmp_88_0 and entity has Cmp_88_3 and entity has Cmp_88_3
{
  entity.get_mut(Cmp_88_0).f0 += 1
}

rule rule_88_4(entity: Entity)
  when entity has Cmp_88_5 and entity has Cmp_88_0 and entity has Cmp_88_7 and resource Cfg_88
{
  entity.get_mut(Cmp_88_5).f0 += 0.5
}

