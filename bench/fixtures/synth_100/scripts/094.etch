resource Cfg_94 { enabled: bool = true }

component Cmp_94_0 { f0: int = 0, f1: int = 0 }

component Cmp_94_1 { f0: int = 0, f1: bool = true }

component Cmp_94_2 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_94_3 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_94_4 { f0: int = 0, f1: bool = true }

component Cmp_94_5 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_94_6 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_94_7 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_94_8 { f0: float = 0.0, f1: int = 0 }

rule rule_94_0(entity: Entity)
  when entity has Cmp_94_5
{
  entity.get_mut(Cmp_94_5).f0 += 0.5
}

rule rule_94_1(entity: Entity)
  when entity has Cmp_94_2 and resource Cfg_94
{
  entity.get_mut(Cmp_94_2).f0 += 0.5
}

rule rule_94_2(entity: Entity)
  when entity has Cmp_94_4 and entity has Cmp_94_1 and entity has Cmp_94_7
{
  entity.get_mut(Cmp_94_4).f0 += 1
}

rule rule_94_3(entity: Entity)
  when entity has Cmp_94_8 and entity has Cmp_94_3 and resource Cfg_94
{
  entity.get_mut(Cmp_94_8).f0 += 0.5
}

rule rule_94_4(entity: Entity)
  when entity has Cmp_94_2
{
  entity.get_mut(Cmp_94_2).f0 += 0.5
}

