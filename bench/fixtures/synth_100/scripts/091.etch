resource Cfg_91 { enabled: bool = true }

component Cmp_91_0 { f0: float = 0.0, f1: int = 0 }

component Cmp_91_1 { f0: float = 0.0, f1: float = 0.0, f2: int = 0 }

component Cmp_91_2 { f0: float = 0.0, f1: int = 0 }

component Cmp_91_3 { f0: float = 0.0, f1: bool = true }

component Cmp_91_4 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_91_5 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_91_6 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_91_7 { f0: float = 0.0, f1: float = 0.0 }

rule rule_91_0(entity: Entity)
  when entity has Cmp_91_7
{
  entity.get_mut(Cmp_91_7).f0 += 0.5
}

rule rule_91_1(entity: Entity)
  when entity has Cmp_91_7 and resource Cfg_91
{
  entity.get_mut(Cmp_91_7).f0 += 0.5
}

rule rule_91_2(entity: Entity)
  when entity has Cmp_91_4 and entity has Cmp_91_6 and entity has Cmp_91_7
{
  entity.get_mut(Cmp_91_4).f0 += 1
}

rule rule_91_3(entity: Entity)
  when entity has Cmp_91_3 and resource Cfg_91
{
  entity.get_mut(Cmp_91_3).f0 += 0.5
}

