resource Cfg_66 { enabled: bool = true }

component Cmp_66_0 { f0: int = 0, f1: bool = true }

component Cmp_66_1 { f0: float = 0.0, f1: int = 0 }

component Cmp_66_2 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_66_3 { f0: float = 0.0, f1: bool = true }

component Cmp_66_4 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_66_5 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_66_6 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_66_7 { f0: int = 0, f1: float = 0.0 }

rule rule_66_0(entity: Entity)
  when entity has Cmp_66_3 and entity has Cmp_66_1 and entity has Cmp_66_5
{
  entity.get_mut(Cmp_66_3).f0 += 0.5
}

rule rule_66_1(entity: Entity)
  when entity has Cmp_66_4 and entity has Cmp_66_6 and entity has Cmp_66_0
{
  entity.get_mut(Cmp_66_4).f0 += 1
}

rule rule_66_2(entity: Entity)
  when entity has Cmp_66_1 and entity has Cmp_66_2 and resource Cfg_66
{
  entity.get_mut(Cmp_66_1).f0 += 0.5
}

rule rule_66_3(entity: Entity)
  when entity has Cmp_66_1 and entity has Cmp_66_7
{
  entity.get_mut(Cmp_66_1).f0 += 0.5
}

rule rule_66_4(entity: Entity)
  when entity has Cmp_66_1 and entity has Cmp_66_3 and entity has Cmp_66_3
{
  entity.get_mut(Cmp_66_1).f0 += 0.5
}

