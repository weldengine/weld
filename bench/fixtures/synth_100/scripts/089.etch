resource Cfg_89 { enabled: bool = true }

component Cmp_89_0 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_89_1 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_89_2 { f0: int = 0, f1: float = 0.0 }

component Cmp_89_3 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_89_4 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_89_5 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_89_6 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_89_7 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_89_8 { f0: int = 0, f1: int = 0 }

rule rule_89_0(entity: Entity)
  when entity has Cmp_89_2 and entity has Cmp_89_6 and entity has Cmp_89_7 and resource Cfg_89
{
  entity.get_mut(Cmp_89_2).f0 += 1
}

rule rule_89_1(entity: Entity)
  when entity has Cmp_89_4
{
  entity.get_mut(Cmp_89_4).f0 += 1
}

rule rule_89_2(entity: Entity)
  when entity has Cmp_89_0 and entity has Cmp_89_3 and entity has Cmp_89_0 and resource Cfg_89
{
  entity.get_mut(Cmp_89_0).f0 += 0.5
}

