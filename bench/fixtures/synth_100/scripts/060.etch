resource Cfg_60 { enabled: bool = true }

component Cmp_60_0 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_60_1 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_60_2 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_60_3 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_60_4 { f0: int = 0, f1: bool = true }

component Cmp_60_5 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_60_6 { f0: float = 0.0, f1: float = 0.0 }

rule rule_60_0(entity: Entity)
  when entity has Cmp_60_4 and resource Cfg_60
{
  entity.get_mut(Cmp_60_4).f0 += 1
}

rule rule_60_1(entity: Entity)
  when entity has Cmp_60_2 and entity has Cmp_60_4 and resource Cfg_60
{
  entity.get_mut(Cmp_60_2).f0 += 0.5
}

rule rule_60_2(entity: Entity)
  when entity has Cmp_60_2 and entity has Cmp_60_2
{
  entity.get_mut(Cmp_60_2).f0 += 0.5
}

