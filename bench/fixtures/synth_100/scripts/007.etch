resource Cfg_7 { enabled: bool = true }

component Cmp_7_0 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_7_1 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_7_2 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_7_3 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_7_4 { f0: float = 0.0, f1: int = 0 }

component Cmp_7_5 { f0: int = 0, f1: bool = true }

component Cmp_7_6 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

rule rule_7_0(entity: Entity)
  when entity has Cmp_7_1 and entity has Cmp_7_6
{
  entity.get_mut(Cmp_7_1).f0 += 0.5
}

rule rule_7_1(entity: Entity)
  when entity has Cmp_7_6 and entity has Cmp_7_6 and entity has Cmp_7_6 and resource Cfg_7
{
  entity.get_mut(Cmp_7_6).f0 += 1
}

rule rule_7_2(entity: Entity)
  when entity has Cmp_7_2 and entity has Cmp_7_0 and entity has Cmp_7_3 and resource Cfg_7
{
  entity.get_mut(Cmp_7_2).f0 += 1
}

rule rule_7_3(entity: Entity)
  when entity has Cmp_7_2 and entity has Cmp_7_5 and entity has Cmp_7_5
{
  entity.get_mut(Cmp_7_2).f0 += 1
}

rule rule_7_4(entity: Entity)
  when entity has Cmp_7_5
{
  entity.get_mut(Cmp_7_5).f0 += 1
}

