resource Cfg_96 { enabled: bool = true }

component Cmp_96_0 { f0: float = 0.0, f1: bool = true }

component Cmp_96_1 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_96_2 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_96_3 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_96_4 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_96_5 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

rule rule_96_0(entity: Entity)
  when entity has Cmp_96_3 and resource Cfg_96
{
  entity.get_mut(Cmp_96_3).f0 += 1
}

rule rule_96_1(entity: Entity)
  when entity has Cmp_96_0 and entity has Cmp_96_2 and entity has Cmp_96_0
{
  entity.get_mut(Cmp_96_0).f0 += 0.5
}

rule rule_96_2(entity: Entity)
  when entity has Cmp_96_1 and resource Cfg_96
{
  entity.get_mut(Cmp_96_1).f0 += 0.5
}

rule rule_96_3(entity: Entity)
  when entity has Cmp_96_2 and entity has Cmp_96_4 and resource Cfg_96
{
  entity.get_mut(Cmp_96_2).f0 += 1
}

