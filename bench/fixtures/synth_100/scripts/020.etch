resource Cfg_20 { enabled: bool = true }

component Cmp_20_0 { f0: float = 0.0, f1: bool = true }

component Cmp_20_1 { f0: int = 0, f1: int = 0 }

component Cmp_20_2 { f0: int = 0, f1: bool = true }

component Cmp_20_3 { f0: float = 0.0, f1: bool = true }

component Cmp_20_4 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_20_5 { f0: int = 0, f1: float = 0.0 }

rule rule_20_0(entity: Entity)
  when entity has Cmp_20_5
{
  entity.get_mut(Cmp_20_5).f0 += 1
}

rule rule_20_1(entity: Entity)
  when entity has Cmp_20_3 and resource Cfg_20
{
  entity.get_mut(Cmp_20_3).f0 += 0.5
}

rule rule_20_2(entity: Entity)
  when entity has Cmp_20_5
{
  entity.get_mut(Cmp_20_5).f0 += 1
}

rule rule_20_3(entity: Entity)
  when entity has Cmp_20_5 and entity has Cmp_20_3 and entity has Cmp_20_1 and resource Cfg_20
{
  entity.get_mut(Cmp_20_5).f0 += 1
}

