resource Cfg_14 { enabled: bool = true }

component Cmp_14_0 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_14_1 { f0: int = 0, f1: int = 0 }

component Cmp_14_2 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_14_3 { f0: int = 0, f1: int = 0 }

component Cmp_14_4 { f0: int = 0, f1: bool = true }

component Cmp_14_5 { f0: float = 0.0, f1: int = 0 }

component Cmp_14_6 { f0: int = 0, f1: int = 0 }

rule rule_14_0(entity: Entity)
  when entity has Cmp_14_3 and entity has Cmp_14_3 and entity has Cmp_14_2 and resource Cfg_14
{
  entity.get_mut(Cmp_14_3).f0 += 1
}

rule rule_14_1(entity: Entity)
  when entity has Cmp_14_3
{
  entity.get_mut(Cmp_14_3).f0 += 1
}

rule rule_14_2(entity: Entity)
  when entity has Cmp_14_0 and entity has Cmp_14_5 and resource Cfg_14
{
  entity.get_mut(Cmp_14_0).f0 += 0.5
}

rule rule_14_3(entity: Entity)
  when entity has Cmp_14_3 and entity has Cmp_14_4 and entity has Cmp_14_3
{
  entity.get_mut(Cmp_14_3).f0 += 1
}

