resource Cfg_82 { enabled: bool = true }

component Cmp_82_0 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_82_1 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_82_2 { f0: float = 0.0, f1: int = 0 }

component Cmp_82_3 { f0: float = 0.0, f1: int = 0 }

component Cmp_82_4 { f0: float = 0.0, f1: int = 0 }

component Cmp_82_5 { f0: float = 0.0, f1: bool = true }

component Cmp_82_6 { f0: float = 0.0, f1: int = 0 }

component Cmp_82_7 { f0: float = 0.0, f1: int = 0 }

component Cmp_82_8 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_82_9 { f0: float = 0.0, f1: bool = true, f2: bool = true }

rule rule_82_0(entity: Entity)
  when entity has Cmp_82_7 and entity has Cmp_82_5
{
  entity.get_mut(Cmp_82_7).f0 += 0.5
}

rule rule_82_1(entity: Entity)
  when entity has Cmp_82_5 and entity has Cmp_82_3 and entity has Cmp_82_4
{
  entity.get_mut(Cmp_82_5).f0 += 0.5
}

rule rule_82_2(entity: Entity)
  when entity has Cmp_82_4 and entity has Cmp_82_5 and resource Cfg_82
{
  entity.get_mut(Cmp_82_4).f0 += 0.5
}

