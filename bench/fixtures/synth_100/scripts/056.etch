resource Cfg_56 { enabled: bool = true }

component Cmp_56_0 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_56_1 { f0: float = 0.0, f1: int = 0 }

component Cmp_56_2 { f0: int = 0, f1: int = 0 }

component Cmp_56_3 { f0: float = 0.0, f1: bool = true }

component Cmp_56_4 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_56_5 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_56_6 { f0: int = 0, f1: bool = true }

component Cmp_56_7 { f0: float = 0.0, f1: float = 0.0 }

rule rule_56_0(entity: Entity)
  when entity has Cmp_56_1 and entity has Cmp_56_6
{
  entity.get_mut(Cmp_56_1).f0 += 0.5
}

rule rule_56_1(entity: Entity)
  when entity has Cmp_56_0 and entity has Cmp_56_2
{
  entity.get_mut(Cmp_56_0).f0 += 1
}

rule rule_56_2(entity: Entity)
  when entity has Cmp_56_7
{
  entity.get_mut(Cmp_56_7).f0 += 0.5
}

rule rule_56_3(entity: Entity)
  when entity has Cmp_56_0 and resource Cfg_56
{
  entity.get_mut(Cmp_56_0).f0 += 1
}

