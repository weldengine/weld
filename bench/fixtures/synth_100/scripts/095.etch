resource Cfg_95 { enabled: bool = true }

component Cmp_95_0 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_95_1 { f0: int = 0, f1: int = 0 }

component Cmp_95_2 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_95_3 { f0: float = 0.0, f1: bool = true }

component Cmp_95_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_95_5 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

rule rule_95_0(entity: Entity)
  when entity has Cmp_95_0 and entity has Cmp_95_3 and entity has Cmp_95_2 and resource Cfg_95
{
  entity.get_mut(Cmp_95_0).f0 += 1
}

rule rule_95_1(entity: Entity)
  when entity has Cmp_95_1
{
  entity.get_mut(Cmp_95_1).f0 += 1
}

rule rule_95_2(entity: Entity)
  when entity has Cmp_95_2 and entity has Cmp_95_5 and entity has Cmp_95_5
{
  entity.get_mut(Cmp_95_2).f0 += 1
}

rule rule_95_3(entity: Entity)
  when entity has Cmp_95_4
{
  entity.get_mut(Cmp_95_4).f0 += 1
}

rule rule_95_4(entity: Entity)
  when entity has Cmp_95_4
{
  entity.get_mut(Cmp_95_4).f0 += 1
}

