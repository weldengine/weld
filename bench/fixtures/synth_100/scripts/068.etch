resource Cfg_68 { enabled: bool = true }

component Cmp_68_0 { f0: int = 0, f1: int = 0 }

component Cmp_68_1 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_68_2 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_68_3 { f0: int = 0, f1: int = 0 }

component Cmp_68_4 { f0: float = 0.0, f1: int = 0 }

rule rule_68_0(entity: Entity)
  when entity has Cmp_68_3 and resource Cfg_68
{
  entity.get_mut(Cmp_68_3).f0 += 1
}

rule rule_68_1(entity: Entity)
  when entity has Cmp_68_2 and entity has Cmp_68_0 and entity has Cmp_68_2
{
  entity.get_mut(Cmp_68_2).f0 += 0.5
}

rule rule_68_2(entity: Entity)
  when entity has Cmp_68_2 and entity has Cmp_68_4 and entity has Cmp_68_0
{
  entity.get_mut(Cmp_68_2).f0 += 0.5
}

