rule rule_22_0(entity: Entity)
  when entity has Cmp_22_7 and entity has Cmp_22_0 and entity has Cmp_22_2 and resource Cfg_22
{
  entity.get_mut(Cmp_22_7).f0 += 1
}

rule rule_22_1(entity: Entity)
  when entity has Cmp_22_4 and entity has Cmp_22_6 and resource Cfg_22
