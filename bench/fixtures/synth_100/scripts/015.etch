resource Cfg_15 { enabled: bool = true }

component Cmp_15_0 { f0: float = 0.0, f1: bool = true, f2: float = 0.0 }

component Cmp_15_1 { f0: int = 0, f1: bool = true }

component Cmp_15_2 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_15_3 { f0: float = 0.0, f1: int = 0 }

component Cmp_15_4 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_15_5 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_15_6 { f0: float = 0.0, f1: float = 0.0 }

rule rule_15_0(entity: Entity)
  when entity has Cmp_15_5 and entity has Cmp_15_2 and entity has Cmp_15_6
{
  entity.get_mut(Cmp_15_5).f0 += 0.5
}

rule rule_15_1(entity: Entity)
  when entity has Cmp_15_6 and entity has Cmp_15_5 and entity has Cmp_15_1 and resource Cfg_15
{
  entity.get_mut(Cmp_15_6).f0 += 0.5
}

rule rule_15_2(entity: Entity)
  when entity has Cmp_15_1 and entity has Cmp_15_6
{
  entity.get_mut(Cmp_15_1).f0 += 1
}

rule rule_15_3(entity: Entity)
  when entity has Cmp_15_0 and entity has Cmp_15_0 and resource Cfg_15
{
  entity.get_mut(Cmp_15_0).f0 += 0.5
}

