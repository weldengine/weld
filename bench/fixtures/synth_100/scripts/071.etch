resource Cfg_71 { enabled: bool = true }

component Cmp_71_0 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_71_1 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_71_2 { f0: int = 0, f1: bool = true }

component Cmp_71_3 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_71_4 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_71_5 { f0: float = 0.0, f1: bool = true }

component Cmp_71_6 { f0: float = 0.0, f1: float = 0.0 }

rule rule_71_0(entity: Entity)
  when entity has Cmp_71_0
{
  entity.get_mut(Cmp_71_0).f0 += 0.5
}

rule rule_71_1(entity: Entity)
  when entity has Cmp_71_4 and entity has Cmp_71_2
{
  entity.get_mut(Cmp_71_4).f0 += 0.5
}

rule rule_71_2(entity: Entity)
  when entity has Cmp_71_4 and resource Cfg_71
{
  entity.get_mut(Cmp_71_4).f0 += 0.5
}

rule rule_71_3(entity: Entity)
  when entity has Cmp_71_3 and entity has Cmp_71_2 and entity has Cmp_71_0
{
  entity.get_mut(Cmp_71_3).f0 += 0.5
}

rule rule_71_4(entity: Entity)
  when entity has Cmp_71_1 and entity has Cmp_71_2 and entity has Cmp_71_6 and resource Cfg_71
{
  entity.get_mut(Cmp_71_1).f0 += 1
}

