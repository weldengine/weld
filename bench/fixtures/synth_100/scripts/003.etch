resource Cfg_3 { enabled: bool = true }

component Cmp_3_0 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_3_1 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_3_2 { f0: float = 0.0, f1: bool = true, f2: bool = true }

component Cmp_3_3 { f0: int = 0, f1: int = 0 }

component Cmp_3_4 { f0: float = 0.0, f1: int = 0, f2: int = 0 }

component Cmp_3_5 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_3_6 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_3_7 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_3_8 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

component Cmp_3_9 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

rule rule_3_0(entity: Entity)
  when entity has Cmp_3_4 and entity has Cmp_3_0 and entity has Cmp_3_6 and resource Cfg_3
{
  entity.get_mut(Cmp_3_4).f0 += 0.5
}

rule rule_3_1(entity: Entity)
  when entity has Cmp_3_0 and resource Cfg_3
{
  entity.get_mut(Cmp_3_0).f0 += 1
}

rule rule_3_2(entity: Entity)
  when entity has Cmp_3_4 and entity has Cmp_3_8
{
  entity.get_mut(Cmp_3_4).f0 += 0.5
}

rule rule_3_3(entity: Entity)
  when entity has Cmp_3_1 and resource Cfg_3
{
  entity.get_mut(Cmp_3_1).f0 += 0.5
}

rule rule_3_4(entity: Entity)
  when entity has Cmp_3_9 and entity has Cmp_3_1 and entity has Cmp_3_9 and resource Cfg_3
{
  entity.get_mut(Cmp_3_9).f0 += 0.5
}

