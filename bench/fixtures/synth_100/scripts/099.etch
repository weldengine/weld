resource Cfg_99 { enabled: bool = true }

component Cmp_99_0 { f0: float = 0.0, f1: bool = true }

component Cmp_99_1 { f0: int = 0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_99_2 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_99_3 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_99_4 { f0: int = 0, f1: bool = true }

component Cmp_99_5 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_99_6 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_99_7 { f0: int = 0, f1: float = 0.0, f2: int = 0 }

rule rule_99_0(entity: Entity)
  when entity has Cmp_99_4 and entity has Cmp_99_3 and entity has Cmp_99_3 and resource Cfg_99
{
  entity.get_mut(Cmp_99_4).f0 += 1
}

rule rule_99_1(entity: Entity)
  when entity has Cmp_99_5 and entity has Cmp_99_5 and entity has Cmp_99_0
{
  entity.get_mut(Cmp_99_5).f0 += 0.5
}

rule rule_99_2(entity: Entity)
  when entity has Cmp_99_6 and entity has Cmp_99_5
{
  entity.get_mut(Cmp_99_6).f0 += 0.5
}

