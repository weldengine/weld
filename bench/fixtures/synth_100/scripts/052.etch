resource Cfg_52 { enabled: bool = true }

component Cmp_52_0 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_52_1 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_52_2 { f0: float = 0.0, f1: bool = true }

component Cmp_52_3 { f0: int = 0, f1: bool = true }

component Cmp_52_4 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

rule rule_52_0(entity: Entity)
  when entity has Cmp_52_0 and entity has Cmp_52_3 and entity has Cmp_52_2 and resource Cfg_52
{
  entity.get_mut(Cmp_52_0).f0 += 0.5
}

rule rule_52_1(entity: Entity)
  when entity has Cmp_52_4 and entity has Cmp_52_4 and entity has Cmp_52_3 and resource Cfg_52
{
  entity.get_mut(Cmp_52_4).f0 += 1
}

rule rule_52_2(entity: Entity)
  when entity has Cmp_52_0 and entity has Cmp_52_2 and resource Cfg_52
{
  entity.get_mut(Cmp_52_0).f0 += 0.5
}

rule rule_52_3(entity: Entity)
  when entity has Cmp_52_1 and entity has Cmp_52_2 and resource Cfg_52
{
  entity.get_mut(Cmp_52_1).f0 += 1
}

