resource Cfg_55 { enabled: bool = true }

component Cmp_55_0 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_55_1 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_55_2 { f0: float = 0.0, f1: bool = true, f2: int = 0 }

component Cmp_55_3 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_55_4 { f0: float = 0.0, f1: int = 0 }

component Cmp_55_5 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_55_6 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_55_7 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_55_8 { f0: float = 0.0, f1: bool = true }

rule rule_55_0(entity: Entity)
  when entity has Cmp_55_1 and entity has Cmp_55_1 and entity has Cmp_55_6
{
  entity.get_mut(Cmp_55_1).f0 += 1
}

rule rule_55_1(entity: Entity)
  when entity has Cmp_55_0 and entity has Cmp_55_1
{
  entity.get_mut(Cmp_55_0).f0 += 0.5
}

rule rule_55_2(entity: Entity)
  when entity has Cmp_55_3 and entity has Cmp_55_6
{
  entity.get_mut(Cmp_55_3).f0 += 1
}

