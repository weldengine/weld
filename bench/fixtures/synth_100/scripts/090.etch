resource Cfg_90 { enabled: bool = true }

component Cmp_90_0 { f0: int = 0, f1: bool = true }

component Cmp_90_1 { f0: int = 0, f1: bool = true, f2: bool = true }

component Cmp_90_2 { f0: int = 0, f1: float = 0.0, f2: bool = true }

component Cmp_90_3 { f0: float = 0.0, f1: int = 0, f2: bool = true }

component Cmp_90_4 { f0: int = 0, f1: float = 0.0 }

component Cmp_90_5 { f0: float = 0.0, f1: int = 0, f2: float = 0.0 }

component Cmp_90_6 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

component Cmp_90_7 { f0: float = 0.0, f1: float = 0.0, f2: float = 0.0 }

rule rule_90_0(entity: Entity)
  when entity has Cmp_90_5 and entity has Cmp_90_4
{
  entity.get_mut(Cmp_90_5).f0 += 0.5
}

rule rule_90_1(entity: Entity)
  when entity has Cmp_90_7 and entity has Cmp_90_3
{
  entity.get_mut(Cmp_90_7).f0 += 0.5
}

rule rule_90_2(entity: Entity)
  when entity has Cmp_90_4
{
  entity.get_mut(Cmp_90_4).f0 += 1
}

