resource Cfg_30 { enabled: bool = true }

component Cmp_30_0 { f0: int = 0, f1: bool = true }

component Cmp_30_1 { f0: int = 0, f1: float = 0.0 }

component Cmp_30_2 { f0: float = 0.0, f1: bool = true }

component Cmp_30_3 { f0: int = 0, f1: bool = true, f2: float = 0.0 }

component Cmp_30_4 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_30_5 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_30_6 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

rule rule_30_0(entity: Entity)
  when entity has Cmp_30_5 and resource Cfg_30
{
  entity.get_mut(Cmp_30_5).f0 += 1
}

rule rule_30_1(entity: Entity)
  when entity has Cmp_30_0 and resource Cfg_30
{
  entity.get_mut(Cmp_30_0).f0 += 1
}

rule rule_30_2(entity: Entity)
  when entity has Cmp_30_0 and resource Cfg_30
{
  entity.get_mut(Cmp_30_0).f0 += 1
}

rule rule_30_3(entity: Entity)
  when entity has Cmp_30_5 and entity has Cmp_30_4
{
  entity.get_mut(Cmp_30_5).f0 += 1
}

rule rule_30_4(entity: Entity)
  when entity has Cmp_30_3 and entity has Cmp_30_6 and entity has Cmp_30_2 and resource Cfg_30
{
  entity.get_mut(Cmp_30_3).f0 += 1
}

