resource Cfg_59 { enabled: bool = true }

component Cmp_59_0 { f0: int = 0, f1: int = 0 }

component Cmp_59_1 { f0: int = 0, f1: int = 0 }

component Cmp_59_2 { f0: int = 0, f1: bool = true }

component Cmp_59_3 { f0: float = 0.0, f1: float = 0.0, f2: bool = true }

component Cmp_59_4 { f0: int = 0, f1: bool = true, f2: int = 0 }

component Cmp_59_5 { f0: int = 0, f1: float = 0.0 }

component Cmp_59_6 { f0: float = 0.0, f1: float = 0.0 }

component Cmp_59_7 { f0: int = 0, f1: int = 0, f2: float = 0.0 }

component Cmp_59_8 { f0: int = 0, f1: int = 0 }

rule rule_59_0(entity: Entity)
  when entity has Cmp_59_1 and entity has Cmp_59_2 and resource Cfg_59
{
  entity.get_mut(Cmp_59_1).f0 += 1
}

rule rule_59_1(entity: Entity)
  when entity has Cmp_59_2 and entity has Cmp_59_5
{
  entity.get_mut(Cmp_59_2).f0 += 1
}

rule rule_59_2(entity: Entity)
  when entity has Cmp_59_4 and entity has Cmp_59_0
{
  entity.get_mut(Cmp_59_4).f0 += 1
}

rule rule_59_3(entity: Entity)
  when entity has Cmp_59_3 and entity has Cmp_59_7 and entity has Cmp_59_1 and resource Cfg_59
{
  entity.get_mut(Cmp_59_3).f0 += 0.5
}

rule rule_59_4(entity: Entity)
  when entity has Cmp_59_8
{
  entity.get_mut(Cmp_59_8).f0 += 1
}

